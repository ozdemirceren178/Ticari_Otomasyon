@using WebApplication3.Models.Sınıflar
@model List<SatisHareket>
@{
    ViewBag.Title = "Detay";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h2>Satış Detay</h2>
<br />

<table class="table table-condensed">
    <tr>
        <th>Satış ID </th>
        <th>Ürün </th>
        <th>Cari </th>
        <th>Personel </th>
        <th>Fiyat </th>
        <th>Adet </th>
        <th>Toplam </th>
        <th>Tarih </th>
       
    </tr>
    <tr>
        @foreach (var x in Model)
        {
        <tr>
            <td>@x.SatisID </td>
            <td>@x.product.ÜrünAd</td>
            <td>@x.cariler.CariAd @x.cariler.CariSoyad</td>
            <td>@x.personal.PersonalAd @x.personal.PersonalSoyad</td>
            <td>@x.Fiyat</td>
            <td>@x.Adet</td>
            <td>@x.ToplamTutar</td>
            <td>@x.Tarih</td>

        </tr>
        }
    </table>
    <button class="btn btn-default" style="background-color:cadetblue ; color:white" >YAZDIR</button>