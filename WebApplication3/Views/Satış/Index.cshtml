@using WebApplication3.Models.Sınıflar
@using WebApplication3.Models.Sınıflar
@using PagedList
@using PagedList.Mvc
@model  PagedList.IPagedList<SatisHareket>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
@using (Html.BeginForm("Index", "Satış", FormMethod.Get))
{
    <div class="d-flex justify-content-end mb-3">
        <div class="input-group" style="max-width: 400px;">
            @Html.TextBox("p", Request.QueryString["p"], new { @class = "form-control", placeholder = "Ürün adını yaz..." })
            <button type="submit" class="btn btn-primary">Ara</button>
        </div>
    </div>
}

<table class=" table table-bordered" style="margin-top:20px">
    <tr>
        <th>ID</th>
        <th>Ürün</th>
        <th>Cari</th>
        <th>Personal</th>
        <th>Adet</th>
        <th>Fiyat</th>
        <th>Toplam</th>
        <th>Tarih</th>
        <th>Güncelle</th>
        <th>Detaylar</th>
    </tr>

    @foreach (var k in Model)
    {

        <tr>
            <td>
                @k.SatisID
            </td>
            <td>@(k.product != null ? k.product.ÜrünAd : "Ürün Yok")</td>
            <td>@k.cariler.CariAd @k.cariler.CariSoyad</td>
            <td>@k.personal.PersonalAd @k.personal.PersonalSoyad</td>
            <td>@k.Adet</td>
            <td>@k.Fiyat</td>
            <td>@k.ToplamTutar</td>
            <td>@Convert.ToDateTime(k.Tarih).ToString("dd/MM/yyyy")</td>
            <td><a href="/Satış/SatisGetir/@k.SatisID" class="btn btn-default" style="background-color:lightblue; color:black">Güncelle</a></td>
            <td><a href="/Satış/Detay/@k.SatisID" class="btn btn-default" style="background-color:lightblue; color:black">Detaylar</a></td>
        </tr>

    }
</table>
@Html.PagedListPager((IPagedList)Model, sayfa => Url.Action("Index", new { sayfa }))


