@using WebApplication3.Models.Sınıflar
@model List<SatisHareket>
@{
    ViewBag.Title = "DepartmanPersonelSatis";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h2>Departman Personel Satış</h2>
<br />
<ol class="breadcrumb" mb-4>
    <li class="breadcrumb-item-active">Personel Adı: @ViewBag.dpers </li>
</ol>

<table class="table table-condensed">
    <tr>
        <th>Ürün </th>
        <th>Cari </th>
        <th>Fiyat </th>
        <th>Adet </th>
        <th>Toplam </th>
        <th>Tarih </th>
    </tr>
    <tr>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.product.ÜrünAd</td>
                <td>@x.cariler.CariAd @x.cariler.CariSoyad</td>
                <td>@x.Fiyat ₺</td>
                <td>@x.Adet</td>
                <td>@x.ToplamTutar</td>
                <td>@Convert.ToDateTime(x.Tarih).ToString("dd/MM/yyyy")</td>
                <td><a href="#" class="btn btn-default" style="background-color:pink">Yazdır</a></td>
            </tr>
            }
        
</table>