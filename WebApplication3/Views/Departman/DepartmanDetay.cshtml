@using WebApplication3.Models.Sınıflar 
@model List<Personal>
@{
    ViewBag.Title = "DepartmanDetay";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h2>Departman Detay Sayfası</h2>


<ol class="breadcrumb" mb-4>
    <li class="breadcrumb-item active">Departman Adı : @ViewBag.d</li>
</ol>


<table class="table table-hover">
    <tr>
      
        <th>Ad Soyad</th>     
        <th>Satışlar</th>
    </tr>
    @foreach (var x in Model)
    {
        <tr>
            <td>@x.PersonalAd @x.PersonalSoyad </td>
            <td><a href="/Departman/DepartmanPersonelSatis/@x.PersonalID" class="btn btn-default" style="background-color:lavender">Satışlar</a> </td>
        </tr>
    }



</table>

