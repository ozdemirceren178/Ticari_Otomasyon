@using WebApplication3.Models.Sınıflar
@model List<Departmant>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<table class=" table table-bordered" style="margin-top:20px">
    <tr>
        <th>ID</th>
        <th>Departman Ad</th>
        <th>SİL </th>
        <th>GÜNCELLE </th>
        <th>DETAYLAR </th>
    </tr>

    @foreach (var k in Model)
    {
        <tr>
            <td>
                @k.DepartmenID
            </td>
            <td>
                @k.DepartmanAd
            </td>
            <td><a href="/Departman/DepartmanSil/@k.DepartmenID" class="btn btn-outline-danger">Sil</a></td>
            <td><a href="/Departman/DepartmanGetir/@k.DepartmenID" class="btn btn-outline-success">Güncelle</a></td>
            <td><a href="/Departman/DepartmanDetay/@k.DepartmenID" class="btn btn-outline-info" >Departman Detay</a></td>
        </tr>
    }
</table>
<a href="/Departman/DepartmanEkle" class="btn btn-info">Departman Ekle</a>

