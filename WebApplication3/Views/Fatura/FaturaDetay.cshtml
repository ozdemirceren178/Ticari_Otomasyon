@using WebApplication3.Models.Sınıflar
@model List<FaturaKalem>
@{
    ViewBag.Title = "FaturaDetay";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h2>Fatura Kalemleri Sayfası</h2>

<table class="table table-hover">
    <tr>
        <th>ID</th>
        <th>Açıklama </th>
        <th>Miktar </th>
        <th>Birim Fiyatı </th>
        <th>Tutar</th>
    </tr>
    @foreach (var x in Model)
    {
        <tr>
            <td>@x.FaturaKalemID</td>
            <td>@x.Aciklama</td>
            <td>@x.Miktar</td>
            <td>@x.BirimFiyatı</td>
            <td>@x.Tutar</td>
        </tr>
    }
</table>
<a href="/Fatura/YeniKalem/" class="btn btn-default" style="background-color:lightblue">Yeni Kalem Girişi</a>


