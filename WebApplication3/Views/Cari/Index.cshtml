@using WebApplication3.Models.Sınıflar
@model List<Cariler>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<table class="table table-striped">
    <tr>
        <th>Cari ID</th>
        <th>Ad</th>
        <th>Soyad</th>
        <th>Şehir</th>
        <th>Mail</th>
        <th>Sil</th>
        <th>Güncelle</th>
        <th>Detaylar</th>

    </tr>
    @foreach(var x in Model)
            {
        <tr>
            <td>@x.CariID</td>
            <td>@x.CariAd</td>
            <td>@x.CariSoyad</td>
            <td>@x.CariSehir</td>
            <td>@x.CariMail</td>
            <td><a href="/Cari/CariSil/@x.CariID" class="btn btn-danger">SİL</a></td>
            <td><a href="/Cari/CariGetir/@x.CariID" class="btn btn-warning">GÜNCELLE</a></td>
            <td><a href="/Cari/MusteriSatıs/@x.CariID" class="btn btn-default" style="background-color:lavender">Satış Geçmişi</a></td>
        </tr>
            }


</table>
<a href="/Cari/YeniCari" class="btn btn-info">Yeni Cari Ekle</a>