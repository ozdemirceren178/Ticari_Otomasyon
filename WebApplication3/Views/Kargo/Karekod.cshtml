@model WebApplication3.Models.Sınıflar.KargoDetay
@{
    ViewBag.Title = "Karekod";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<div>
    @using (Html.BeginForm("Karekod", "Kargo", FormMethod.Post))
    {
        @Html.HiddenFor(x=>x.KargoDetayid)
        @Html.TextBoxFor(x=>x.TakipKodu, new {@class = "form-control", @readonly="readonly"})
    }
    <br />
    @if (ViewBag.karekodimage != null)
    {
        <img src="@ViewBag.karekodimage" alt="" style="width:400px; height:400px" />
    }
</div>

