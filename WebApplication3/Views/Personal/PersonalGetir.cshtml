@model WebApplication3.Models.Sınıflar.Personal
@{
    ViewBag.Title = "PersonalGetir";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h2>Personal Güncelleme Ekranı</h2>
<br />

@using (Html.BeginForm("PersonalGüncelle", "Personal", FormMethod.Post  ,new { enctype = "multipart/form-data" } ))
{
    <div class="form-group">
        @Html.HiddenFor(x => x.PersonalID)
        @Html.LabelFor(x => x.PersonalAd)
        @Html.TextBoxFor(x => x.PersonalAd, new { @class = " form-control" })
        <br />
        @Html.LabelFor(x => x.PersonalSoyad)
        @Html.TextBoxFor(x => x.PersonalSoyad, new { @class = " form-control" })
        <br />
        @Html.LabelFor(x => x.PersonalGorsel)
    <input type="file", name="personelGörsel" />
        <br />
        @Html.LabelFor(x => x.Departmant)
        @Html.DropDownListFor(x => x.DepartmanId, (List<SelectListItem>)ViewBag.dgr1, new { @class = "form-control" })
        
                <br />
                <button class="btn btn-default" style="background-color:thistle">Güncelle</button>
            </div>
        }
