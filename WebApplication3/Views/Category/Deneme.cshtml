@model WebApplication3.Models.Sınıflar.Class3
@{
    ViewBag.Title = "Deneme";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Deneme</h2>
<script src="~/Scripts/jquery-3.7.0.min.js"></script>
<script>

    $(function () {

        $('#DrpKategori').change(function () {

            var id = $('#DrpKategori').val();

            $.ajax({

                url: '/Category/UrunGetir',

                data: { p: id },

                type: "POST",

                dataType: "Json",

                success: function (data) {

                    console.log(data);

                    $('#DrpÜrünler').empty();

                    for (var i = 0; i < data.length; i++) {

                        $('#DrpÜrünler').append("<option value='" + data[i].Value + "'>" + data[i].Text + "</Option>");

                    }

                }

            });

        });

    });

</script>


<br />
<div>
    <h2> Kategoriler- Ürünler </h2>
</div>
<br />
<div>
    @Html.Label("Kategoriler")
    @Html.DropDownList("DrpKategori", Model.Kategoriler, "-----Kategori Seç----", new { @class = "form-control" })
    <br />
    @Html.Label("Ürünler")
    @Html.DropDownList("DrpÜrünler", Model.Urunler, "-----Ürün Seç----", new { @class = "form-control" })

</div>