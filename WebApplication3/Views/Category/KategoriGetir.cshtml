@model WebApplication3.Models.Sınıflar.Category
@{
    ViewBag.Title = "KategoriGetir";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
<h2>Kategori Güncelleme</h2>
<br />

@using(Html.BeginForm("KategoriGüncelle", "Category", FormMethod.Post))
            {

    <div class=" form-group">
        @Html.LabelFor(x=>x.KategoriAd)
        @Html.TextBoxFor(x=>x.KategoriAd, new {@class=" form-control"})
       @Html.HiddenFor(x=>x.KategoriID)
    
    </div>
    <br />
    <button class="btn btn-outline-warning">Güncelle</button>    
    }