@model WebApplication3.Models.Sınıflar.SatisHareket
@{
    ViewBag.Title = "SatisYap";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Satış Yap </h2>
<form class="form-group" method="post">
    @Html.Label("Ürün ID")
    <input type="text" , name="Urunid" , value="@ViewBag.dgr2" class="form-control" readonly />

    <br />
    @Html.Label("Personeller")
    @Html.DropDownListFor(x => x.PersonalId, (List<SelectListItem>)ViewBag.dgr1, new { @class = "form-control" })
    <br />
    <br />
    @Html.LabelFor(x => x.CariId)
    @Html.TextBoxFor(x => x.CariId, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.Adet)
    <input type="number" class="form-control" max="10" min="0" placeholder="adet giriniz" id="txt1" onchange="sum();" name="Adet" />
    <br />
    @Html.LabelFor(x => x.Fiyat)
    <input type="text" , name="Fiyat" , value="@ViewBag.dgr3" class="form-control" id="txt2" onkeyup="sum();" />
    <br />
    @Html.Label("Toplam Tutar")
    <input type="text" , name="ToplamTutar" , value="@ViewBag.dgr3" class="form-control" id="txt3"  />
    <br />
   
    <button class="btn btn-outline-primary">Satış Yap</button>
</form>
<br />
@*<input  type="text" id="txt1" onkeyup="sum();"/>*@
@*<input  type="text" id="txt2" onkeyup="sum();"/>*@
@*<input  type="text" id="txt3"/>*@
<script>
    function sum()
    {
        var sayi1 = document.getElementById('txt1').value;
        var sayi2 = document.getElementById('txt2').value;
        var sonuc = parseInt(sayi1) * parseInt(sayi2);
        if (!isNaN(sonuc)) {
            document.getElementById('txt3').value= sonuc;
        }
    }
</script>